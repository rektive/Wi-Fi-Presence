:root {
    --bg-dark: #0f141c;
    --card-bg: #18202c;
    --border-color: #233042;
    --accent-blue: #0088ff;
    --accent-green: #00e676;
    --accent-yellow: #ffd600;
    --accent-red: #ff3d00;
    --text-primary: #f0f4f8;
    --text-secondary: #94a3b8;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

body {
    background-color: var(--bg-dark);
    color: var(--text-primary);
    padding: 24px;
    min-height: 100vh;
}

.dashboard-container {
    max-width: 1400px;
    margin: 0 auto;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 24px;
}

.header h1 {
    font-size: 26px;
    font-weight: 700;
    color: #fff;
}

.subtext {
    font-size: 14px;
    color: var(--text-secondary);
}

.pill {
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
}

.pill.connected { background: rgba(0, 230, 118, 0.2); color: var(--accent-green); }
.pill.disconnected { background: rgba(255, 61, 0, 0.2); color: var(--accent-red); }

.metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
}

.card {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 20px;
}

.card h3 {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--text-secondary);
    margin-bottom: 16px;
}

.state-badge {
    display: inline-block;
    padding: 10px 24px;
    border-radius: 8px;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

.state-vacant { background: rgba(0, 230, 118, 0.15); color: var(--accent-green); border: 1px solid var(--accent-green); }
.state-entering { background: rgba(255, 214, 0, 0.15); color: var(--accent-yellow); border: 1px solid var(--accent-yellow); }
.state-occupied { background: rgba(255, 61, 0, 0.15); color: var(--accent-red); border: 1px solid var(--accent-red); }
.state-exiting { background: rgba(0, 136, 255, 0.15); color: var(--accent-blue); border: 1px solid var(--accent-blue); }

.state-subtext, .count-subtext {
    font-size: 13px;
    color: var(--text-secondary);
}

.count-display {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 10px;
}

#headcount-val {
    font-size: 48px;
    font-weight: 800;
    color: #fff;
}

.count-unit {
    font-size: 18px;
    color: var(--text-secondary);
}

.meter-container {
    height: 14px;
    background: #0b0f14;
    border-radius: 7px;
    overflow: hidden;
    margin: 18px 0 10px 0;
}

.meter-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-green), var(--accent-yellow), var(--accent-red));
    transition: width 0.15s ease-out;
}

.meter-labels {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--text-secondary);
}

.charts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

@media (max-width: 900px) {
    .charts-grid {
        grid-template-columns: 1fr;
    }
}

.canvas-wrapper {
    position: relative;
    height: 280px;
    width: 100%;
}
